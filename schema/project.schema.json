{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QRL Ecosystem Project",
  "version": 6,
  "description": "Schema for QRL ecosystem project submissions using faceted classification",
  "type": "object",
  "required": [
    "id",
    "name",
    "project_type",
    "primary_category",
    "secondary_categories",
    "capabilities",
    "platforms",
    "keywords",
    "maturity",
    "availability",
    "qrl_relationship",
    "qrl_support",
    "description",
    "publisher",
    "maintainers",
    "source_availability",
    "repositories",
    "links",
    "listed_at",
    "data_updated_at",
    "features"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "project_type": {
      "type": "string",
      "enum": ["protocol", "application", "infrastructure", "tooling", "resource"]
    },
    "primary_category": {
      "$ref": "#/$defs/category"
    },
    "secondary_categories": {
      "type": "array",
      "maxItems": 2,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/category" }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/capability" }
    },
    "platforms": {
      "type": "array",
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/platform" }
    },
    "keywords": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      }
    },
    "maturity": {
      "type": "string",
      "enum": ["prototype", "beta", "stable", "deprecated"]
    },
    "availability": {
      "type": "string",
      "enum": ["live", "limited", "paused", "offline", "archived"]
    },
    "maintenance": {
      "type": "string",
      "enum": ["active", "low-activity", "inactive"]
    },
    "qrl_relationship": {
      "type": "string",
      "enum": ["native", "deployed", "integrated", "ecosystem-resource"]
    },
    "qrl_support": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/qrl_support" }
    },
    "deployments": {
      "type": "array",
      "items": { "$ref": "#/$defs/deployment" }
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 280
    },
    "publisher": {
      "$ref": "#/$defs/publisher"
    },
    "maintainers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/maintainer" }
    },
    "source_availability": {
      "type": "string",
      "enum": ["full", "partial", "unavailable", "not-applicable"]
    },
    "repositories": {
      "type": "array",
      "items": { "$ref": "#/$defs/repository" }
    },
    "links": {
      "type": "array",
      "items": { "$ref": "#/$defs/link" }
    },
    "security_reviews": {
      "type": "array",
      "items": { "$ref": "#/$defs/security_review" }
    },
    "evidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidence" }
    },
    "relationships": {
      "type": "array",
      "items": { "$ref": "#/$defs/relationship" }
    },
    "previous_names": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "assets": {
      "type": "array",
      "items": { "$ref": "#/$defs/asset" }
    },
    "listed_at": {
      "type": "string",
      "format": "date"
    },
    "data_updated_at": {
      "type": "string",
      "format": "date"
    },
    "project_launched_at": {
      "type": "string",
      "format": "date"
    },
    "last_release_at": {
      "type": "string",
      "format": "date"
    },
    "last_verified_at": {
      "type": "string",
      "format": "date"
    },
    "logos": {
      "type": "array",
      "maxItems": 4,
      "items": { "$ref": "#/$defs/logo" }
    },
    "gallery": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": { "$ref": "#/$defs/gallery_item" }
    },
    "long_description": {
      "type": "string"
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "category": {
      "type": "string",
      "enum": [
        "finance",
        "payments-commerce",
        "assets-tokenization",
        "identity-naming-privacy",
        "governance-coordination",
        "interoperability-messaging-data",
        "gaming-virtual-worlds",
        "social-creator-content",
        "security-custody-account-management",
        "network-operations",
        "developer-experience",
        "education-research-ecosystem",
        "utility-storage-compute"
      ]
    },
    "capability": {
      "type": "string",
      "enum": [
        "analytics",
        "atomic-swap",
        "cli",
        "compiler",
        "contract-template",
        "deployment",
        "dex",
        "education",
        "explorer",
        "faucet",
        "hardware-wallet",
        "key-management",
        "library",
        "liquid-staking",
        "marketplace",
        "mining-pool",
        "news",
        "node-client",
        "notarization",
        "oracle",
        "payments",
        "prediction-market",
        "rpc",
        "sdk",
        "staking",
        "token-creator",
        "validator",
        "wallet",
        "wallet-connector"
      ]
    },
    "platform": {
      "type": "string",
      "enum": ["web", "browser-extension", "desktop", "mobile"]
    },
    "qrl_support": {
      "type": "object",
      "required": ["generation", "environments"],
      "properties": {
        "generation": {
          "type": "string",
          "enum": ["1.x", "2.0"]
        },
        "environments": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["mainnet", "testnet", "devnet", "local-private"]
          }
        },
        "evidence": {
          "type": "array",
          "items": { "type": "string", "format": "uri" }
        }
      },
      "additionalProperties": false
    },
    "deployment": {
      "type": "object",
      "required": ["id", "network", "operational_state", "identifiers", "evidence", "source_verification"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "network": {
          "type": "string",
          "enum": [
            "qrl-1-mainnet",
            "qrl-1-testnet",
            "qrl-1-local-private",
            "qrl-2-testnet-v2",
            "qrl-2-devnet",
            "qrl-2-local-private"
          ]
        },
        "operational_state": {
          "type": "string",
          "enum": ["live", "limited", "paused", "offline"]
        },
        "identifiers": {
          "type": "array",
          "items": { "$ref": "#/$defs/deployment_identifier" }
        },
        "evidence": {
          "type": "array",
          "items": { "type": "string", "format": "uri" }
        },
        "source_verification": {
          "type": "string",
          "enum": ["verified", "unverified", "not-applicable", "unknown"]
        }
      },
      "additionalProperties": false
    },
    "deployment_identifier": {
      "type": "object",
      "required": ["type", "value"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["contract", "proxy", "implementation", "factory", "token", "transaction", "service", "other"]
        },
        "value": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "publisher": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" }
      },
      "additionalProperties": false
    },
    "maintainer": {
      "type": "object",
      "required": ["name", "contact"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "contact": { "type": "string", "format": "uri" }
      },
      "additionalProperties": false
    },
    "repository": {
      "type": "object",
      "required": ["id", "role", "url", "license"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "role": {
          "type": "string",
          "enum": ["contracts", "frontend", "client", "sdk", "infrastructure", "tooling", "content", "other"]
        },
        "url": { "type": "string", "format": "uri" },
        "license": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "link": {
      "type": "object",
      "required": ["type", "url"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["website", "documentation", "status", "support", "community", "social", "package", "app-store", "application", "security", "governance"]
        },
        "url": { "type": "string", "format": "uri" },
        "label": { "type": "string", "minLength": 1 },
        "platform": { "type": "string", "minLength": 1 },
        "primary": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "security_review": {
      "type": "object",
      "required": ["auditor", "report_url", "scope", "remediation_status"],
      "properties": {
        "auditor": { "type": "string", "minLength": 1 },
        "report_url": { "type": "string", "format": "uri" },
        "report_date": { "type": "string", "format": "date" },
        "repository_id": { "type": "string" },
        "revision": { "type": "string" },
        "scope": { "type": "string", "minLength": 1 },
        "deployment_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "remediation_status": {
          "type": "string",
          "enum": ["not-reported", "open", "partial", "completed"]
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["type", "url"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["qrl-relationship", "deployment", "integration", "ownership"]
        },
        "url": { "type": "string", "format": "uri" },
        "note": { "type": "string" },
        "checked_at": { "type": "string", "format": "date" }
      },
      "additionalProperties": false
    },
    "relationship": {
      "type": "object",
      "required": ["type", "project_id"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["fork-of", "successor-to", "frontend-for", "uses-protocol", "part-of"]
        },
        "project_id": { "type": "string" }
      },
      "additionalProperties": false
    },
    "asset": {
      "type": "object",
      "required": ["type", "name"],
      "properties": {
        "type": { "type": "string", "enum": ["token", "collection"] },
        "name": { "type": "string", "minLength": 1 },
        "symbol": { "type": "string" },
        "deployment_id": { "type": "string" },
        "identifier": { "type": "string" },
        "evidence_url": { "type": "string", "format": "uri" }
      },
      "additionalProperties": false
    },
    "logo": {
      "type": "object",
      "required": ["path"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*/[^/]+\\.(png|webp|svg)$"
        },
        "description": { "type": "string" }
      },
      "additionalProperties": false
    },
    "gallery_item": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "path", "caption"],
          "properties": {
            "type": { "const": "image" },
            "path": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*/[^/]+\\.(png|jpe?g|webp)$"
            },
            "caption": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "pattern": "^[^\\r\\n]+$"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "id", "caption"],
          "properties": {
            "type": { "const": "youtube" },
            "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{11}$" },
            "caption": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "pattern": "^[^\\r\\n]+$"
            }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "additionalProperties": false
}
